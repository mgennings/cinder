{
  "name": "blip",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
		"build": "vite build && node scripts/build-social-shell.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "capture:gallery": "node scripts/capture-gallery.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1076.0",
    "@aws-sdk/client-dynamodb": "^3.1076.0",
    "@aws-sdk/client-s3": "^3.1076.0",
    "@aws-sdk/lib-dynamodb": "^3.1076.0",
    "@aws-sdk/s3-request-presigner": "^3.1076.0",
    "@playwright/test": "1.61.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "^26.1.1",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
